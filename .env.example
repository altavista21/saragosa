# API listens on loopback by default. Put a trusted reverse proxy in front
# before exposing it to another host or network.
SARAGOSA_API_ADDR=127.0.0.1:8080

# Path to Suricata EVE JSON for future collector integration.
# The current collector reads JSON Lines from stdin and does not open this path.
SARAGOSA_EVE_PATH=/var/log/suricata/eve.json
